[Unit]
Description=Memecoin Telegram scanner bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/memebot
EnvironmentFile=/opt/memebot/.env
ExecStart=/opt/memebot/.venv/bin/python /opt/memebot/memebot.py
Restart=always
RestartSec=5
User=memebot

[Install]
WantedBy=multi-user.target
