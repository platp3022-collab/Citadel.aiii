# Скопируй в .env и поправь под себя. .env не коммитится (см. ../.gitignore).

# --- банк и риск ----------------------------------------------------------------------
BANKROLL=1000            # стартовый банк в USDC (в бумажном режиме — виртуальный)
RISK_PER_TRADE=0.02      # доля банка на один вход
MAX_POSITIONS=6          # сколько позиций держим одновременно
MAX_POSITION_USD=150     # потолок одной позиции
DAILY_LOSS_LIMIT=0.06    # -6% за сутки → бот перестаёт открывать новое
MAX_DRAWDOWN=0.20        # -20% от пика эквити → полный стоп

# --- фильтры рынков -------------------------------------------------------------------
UNIVERSE_SIZE=40         # сколько рынков держим в работе
MIN_LIQUIDITY=5000       # минимум ликвидности в стакане, $
MIN_VOLUME_24H=20000     # минимум оборота за сутки, $
MAX_SPREAD=0.03          # шире 3 центов не торгуем — спред съест перевес

# --- исполнение -----------------------------------------------------------------------
MIN_EDGE=0.02            # минимальный перевес после комиссии, в долях цены
TAKE_PROFIT=0.06         # +6 центов → выход
STOP_LOSS=0.04           # -4 цента → выход
TIME_STOP_MIN=240        # держим позицию не дольше 4 часов
FEE_BPS=0                # тейкерская комиссия в базисных пунктах
SCAN_INTERVAL=45         # как часто пересчитываем вселенную, сек
TICK_INTERVAL=3          # как часто переоцениваем позиции и рисуем кадр, сек

# --- боевой режим (--live), в бумажном не нужен ---------------------------------------
# Предохранитель: без этой строки --live не запустится.
POLYBOT_CONFIRM_LIVE=
# Приватный ключ кошелька Polygon, которым подписываются ордера.
POLYMARKET_PRIVATE_KEY=
# Ключи CLOB. Если пусто — бот выведет их из приватного ключа при старте.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# 0 — обычный EOA-кошелёк, 1 — Polymarket proxy, 2 — Gnosis Safe.
POLYMARKET_SIGNATURE_TYPE=0
# Адрес кошелька с USDC, если он не совпадает с адресом ключа (для proxy/Safe).
POLYMARKET_FUNDER=
