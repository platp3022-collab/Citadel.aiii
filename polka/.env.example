# Скопируй в polka/.env и заполни. Файл .env не коммитится.

# ── обязательное ────────────────────────────────────────────────────────
# Токен от @BotFather. Если он хоть раз попадал в переписку или скриншот,
# сделай /revoke и выпусти новый.
TELEGRAM_BOT_TOKEN=

# Твой личный chat id. Узнать: напиши боту /id
POLKA_CHAT_ID=

# Ключ Anthropic. Без него мысли складываются во «Входящее» без разбора.
ANTHROPIC_API_KEY=

# ── мини-приложение и команда быстрого доступа ──────────────────────────
# Публичный https-адрес, на котором висит Полка. Нужен для кнопки в Telegram.
# Локально удобно поднять туннелем: cloudflared tunnel --url http://localhost:8443
POLKA_PUBLIC_URL=

# Секрет для прямых запросов к Полке. Мастер заводит его сам.
POLKA_CAPTURE_TOKEN=

# Канал для двойного касания задней крышки айфона. Полка сама держит связь
# с этой доской, поэтому публичный адрес для касания не нужен.
# Имя канала это и пароль: мастер придумывает его сам, никому не показывай.
POLKA_RELAY_TOPIC=
POLKA_RELAY_URL=https://ntfy.sh

# ── необязательное ──────────────────────────────────────────────────────
# Модель разбора. По умолчанию claude-opus-5.
POLKA_MODEL=claude-opus-5

# Расшифровка голосовых, отправленных боту.
# У Groq это бесплатно: console.groq.com/keys, ключ вида gsk_...
GROQ_API_KEY=

# Альтернатива Groq, платная. Если заданы оба, для расшифровки берётся Groq.
# Этот же ключ нужен, чтобы бот отвечал голосом: у бесплатных сервисов
# нет русского голоса.
OPENAI_API_KEY=

# Отвечать ли голосом на надиктованное. Работает только с OPENAI_API_KEY.
# Поставь 0, чтобы бот всегда отвечал текстом.
POLKA_VOICE_REPLY=1

# Тихие часы: в это окно не приходит ничего, кроме важности 5.
POLKA_QUIET_FROM=23
POLKA_QUIET_TO=8

# Твой часовой пояс, смещение от UTC в часах. Киев зимой 2, летом 3.
POLKA_TZ_OFFSET=3

# Где слушать. Порт менять, только если 8443 занят.
POLKA_HOST=0.0.0.0
POLKA_PORT=8443
