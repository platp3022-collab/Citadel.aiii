//@version=6
// =============================================================================
//  FVG SNIPER — карта имбалансов
// -----------------------------------------------------------------------------
//  Чистый анализ, без сигналов и уровней входа:
//    · FVG таймфрейма анализа (5m) и FVG самого графика (3m)
//    · GAP = наложение двух FVG на одном уровне (5m + 3m) — главная зона
//    · Ликвидность: уровни тянутся вправо, пока их не снимут; свип подписан
//    · SMT-дивергенция против коррелирующего инструмента — рисуется всегда
//
//  График ставим на 3m, "ТФ анализа" оставляем 5.
// =============================================================================
indicator("FVG Sniper", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ================================ ВВОД =======================================
gMain = "Основное"
htfTF     = input.timeframe("5", "Таймфрейм анализа", group = gMain, tooltip = "FVG ищутся на нём. График держи младше — например анализ 5, график 3.")
density   = input.string("Средне", "Плотность разметки", options = ["Мало", "Средне", "Много"], group = gMain, tooltip = "Одна ручка вместо семи счётчиков: сколько зон, уровней, отметок структуры и сетапов держать одновременно.")
visMode   = input.string("Последние N баров", "Что показывать", options = ["Последние N баров", "Текущий день", "Всё"], group = gMain)
histBars  = input.int(200, "Окно, баров", minval = 20, maxval = 5000, group = gMain)
lifeBars  = input.int(40, "Время жизни зоны, баров", minval = 0, maxval = 1000, group = gMain, tooltip = "База для FVG графика. FVG анализа и уровни живут втрое дольше, зоны GAP — вдвое. 0 — жить до отработки.")
sens      = input.float(0.15, "Минимальный размер (× ATR)", minval = 0, step = 0.05, group = gMain, tooltip = "Фильтр мелочи. Больше значение — чище график.")
pivotLen  = input.int(5, "Длина пивота", minval = 1, maxval = 50, group = gMain, tooltip = "Меньше — больше свингов и свипов.")

gShow = "Что рисовать"
showHtf    = input.bool(true, "FVG анализа",                     group = gShow)
showLtf    = input.bool(true, "FVG графика",                     group = gShow)
showOvl    = input.bool(true, "GAP — два FVG на одном уровне",   group = gShow)
showLiq    = input.bool(true, "Ликвидность и свипы",             group = gShow)
showKey    = input.bool(true, "Ключевые уровни: день, неделя, Азия", group = gShow)
kzOn       = input.bool(true, "Килзоны",                         group = gShow)
showStruct = input.bool(true, "Структура BOS / CHoCH",           group = gShow)
showSetup  = input.bool(true, "Уровни сетапа",                   group = gShow)
showPanel  = input.bool(true, "Панель",                          group = gShow)
fillMode   = input.string("Заливка", "Стиль зон", options = ["Заливка", "Только границы"], group = gShow, tooltip = "«Только границы» убирает заливку — график перестаёт быть серым.")

gEntry = "Вход"
entryOn   = input.bool(true,  "Считать готовность", group = gEntry)
needScore = input.int(5, "Нужно совпадений из 7", minval = 1, maxval = 7, group = gEntry, tooltip = "Свип · SMT · зона · реакция · байас MA · килзона · структура.")
kzHard    = input.bool(false, "Только внутри килзоны", group = gEntry)
slPad     = input.float(0.25, "Отступ стопа (× ATR)", minval = 0, step = 0.05, group = gEntry)
rr1       = input.float(2.0,  "Цель 1 (R)", minval = 0.1, step = 0.1, group = gEntry)
rr2       = input.float(3.5,  "Цель 2 (R)", minval = 0.1, step = 0.1, group = gEntry)

gSmt = "SMT"
smtSym     = input.symbol("", "Инструмент (пусто = авто)", group = gSmt, tooltip = "Пусто — пара подбирается сама: форекс → TVC:DXY, золото ↔ серебро, BTC ↔ ETH, NQ ↔ SPX.")
smtInverse = input.bool(false, "Инверсия (при ручном вводе)", group = gSmt)

gKz = "Килзоны"
kzTz    = input.string("America/New_York", "Таймзона", options = ["America/New_York", "Europe/London", "Europe/Kyiv", "Europe/Moscow", "UTC", "Asia/Tokyo"], group = gKz, tooltip = "Часы ниже — классические килзоны ICT по Нью-Йорку.")
kzAsiaS = input.session("2000-0000", "Азия",      group = gKz)
kzLonS  = input.session("0200-0500", "Лондон",    group = gKz)
kzNyS   = input.session("0700-1000", "Нью-Йорк",  group = gKz)
kzUse   = input.string("Лондон + Нью-Йорк", "Рабочие килзоны", options = ["Лондон + Нью-Йорк", "Только Лондон", "Только Нью-Йорк", "Все три"], group = gKz)

gMa = "Скользящие средние"
ma1On   = input.bool(true, "MA 1", group = gMa, inline = "m1")
ma1Type = input.string("EMA", "", options = ["EMA", "SMA"], group = gMa, inline = "m1")
ma1Len  = input.int(50, "", minval = 1, group = gMa, inline = "m1")
ma1TF   = input.timeframe("", "", group = gMa, inline = "m1", tooltip = "Пусто — таймфрейм графика.")
ma2On   = input.bool(true, "MA 2", group = gMa, inline = "m2")
ma2Type = input.string("EMA", "", options = ["EMA", "SMA"], group = gMa, inline = "m2")
ma2Len  = input.int(200, "", minval = 1, group = gMa, inline = "m2")
ma2TF   = input.timeframe("", "", group = gMa, inline = "m2")

gUi = "Цвета"
cBull    = input.color(color.new(#00bfa5, 60), "Вверх", group = gUi, inline = "c")
cBear    = input.color(color.new(#ff5252, 60), "Вниз",  group = gUi, inline = "c")
cKey     = input.color(#ffee58, "Ключевые",             group = gUi, inline = "c")
panelPos = input.string("Справа сверху", "Угол панели", options = ["Справа сверху", "Слева сверху", "Справа снизу", "Слева снизу"], group = gUi)

// ============================= ПРОИЗВОДНОЕ ===================================
// «плотность» разворачивается в счётчики
htfKeep    = density == "Мало" ? 2 : density == "Средне" ? 4 : 8
ltfKeep    = density == "Мало" ? 2 : density == "Средне" ? 4 : 8
ovlKeep    = density == "Мало" ? 2 : density == "Средне" ? 4 : 8
liqKeep    = density == "Мало" ? 2 : density == "Средне" ? 3 : 6
structKeep = density == "Мало" ? 3 : density == "Средне" ? 6 : 10
keepSetups = density == "Мало" ? 2 : density == "Средне" ? 3 : 5
sweepKeep  = density == "Мало" ? 25 : density == "Средне" ? 40 : 80

// «время жизни» и «минимальный размер» — в свои наборы
htfLife   = lifeBars * 3
ltfLife   = lifeBars
ovlLife   = lifeBars * 2
liqLife   = lifeBars * 3
htfMinAtr = sens
ltfMinAtr = sens * 0.8
ovlMinAtr = sens * 0.4

// бывшие настройки, которые на практике всегда стояли одинаково
showCE    = true
showEdges = true
ovlText   = true
rightPad  = 4
dimLtf    = 20
showSweep = showLiq
showSmt   = true
smtLine   = true
maFill    = true
dispMult  = 1.0
entryWin  = 15
reactWin  = 3
inSession = true
lvlPD     = showKey
lvlPW     = showKey
lvlDO     = showKey
lvlAsia   = showKey
lvlBox    = showKey
structOn  = showStruct

// цвета, которые незачем настраивать поштучно
cOvlB   = color.new(cBull, math.max(0, color.t(cBull) - 25))
cOvlS   = color.new(cBear, math.max(0, color.t(cBear) - 25))
cLiq    = color.new(#787b86, 30)
cSweep  = #42a5f5
cSmt    = #ffc107
ma1Col  = #42a5f5
ma2Col  = #ab47bc
kzAsiaC = color.new(#ffa726, 92)
kzLonC  = color.new(#42a5f5, 90)
kzNyC   = color.new(#26a69a, 90)

// =============================== ТИПЫ ========================================
type Fvg
    float top
    float bot
    bool  bull
    bool  htf
    int   born
    box   bx
    line  lnT
    line  lnB
    line  lnC

type Ovl
    float top
    float bot
    bool  bull
    int   born
    box   bx
    label lb

type Liq
    float price
    bool  isHigh
    float compH
    float compL
    int   bar
    bool  taken
    int   takenBar
    string tag
    line  ln
    label lb
    label tg

killFvg(Fvg f) =>
    box.delete(f.bx)
    line.delete(f.lnT)
    line.delete(f.lnB)
    line.delete(f.lnC)
    0

killLiq(Liq q) =>
    line.delete(q.ln)
    label.delete(q.lb)
    label.delete(q.tg)
    0

var array<Fvg> fvgs = array.new<Fvg>()
var array<Ovl> ovls = array.new<Ovl>()
var array<Liq> liqs = array.new<Liq>()
var array<label> smtLbls = array.new<label>()
var array<line>  smtLines = array.new<line>()
var array<int>   ovlCount = array.new<int>(1, 0)   // счётчик созданных зон GAP

atr       = ta.atr(14)
tfMs      = timeframe.in_seconds(timeframe.period) * 1000
padMs     = tfMs * rightPad
tfSecChart= timeframe.in_seconds(timeframe.period)
tfSecHtf  = timeframe.in_seconds(htfTF)

// окно видимости: старее него объекты просто не создаются
inWindow  = visMode == "Всё" or visMode == "Текущий день" or bar_index > last_bar_index - histBars
newDay    = ta.change(time("D")) != 0
dayReset  = visMode == "Текущий день" and newDay

// при смене дня в режиме «Текущий день» стираем всё, что осталось со вчера
if dayReset
    if array.size(fvgs) > 0
        for i = array.size(fvgs) - 1 to 0
            f = array.get(fvgs, i)
            killFvg(f)
            array.remove(fvgs, i)
    if array.size(ovls) > 0
        for i = array.size(ovls) - 1 to 0
            o = array.get(ovls, i)
            box.delete(o.bx)
            label.delete(o.lb)
            array.remove(ovls, i)
    if array.size(liqs) > 0
        for i = array.size(liqs) - 1 to 0
            q = array.get(liqs, i)
            killLiq(q)
            array.remove(liqs, i)

// ============================ ДАННЫЕ 5m ======================================
htfFeed() =>
    bull = low[1] > high[3]
    bear = high[1] < low[3]
    [bull ? low[1] : na, bull ? high[3] : na, bear ? low[3] : na, bear ? high[1] : na, time[2], ta.atr(14)]

[hBullTop, hBullBot, hBearTop, hBearBot, hAnchor, hAtr] =
     request.security(syminfo.tickerid, htfTF, htfFeed(), lookahead = barmerge.lookahead_off)

newHtfBar = not na(hAnchor) and ta.change(hAnchor) != 0

// ======================= КОРРЕЛИРУЮЩИЙ ИНСТРУМЕНТ ============================
// пустое поле = подбираем пару сами по текущему рынку
tkr    = syminfo.ticker
isFx   = syminfo.type == "forex" or syminfo.type == "cfd"
// берём только бесплатные общедоступные фиды, чтобы скрипт не падал без подписки
autoSym = str.contains(tkr, "XAU") ? "TVC:SILVER" :
     str.contains(tkr, "XAG") ? "TVC:GOLD" :
     str.contains(tkr, "BTC") ? "BINANCE:ETHUSDT" :
     str.contains(tkr, "ETH") ? "BINANCE:BTCUSDT" :
     syminfo.type == "crypto" ? "BINANCE:BTCUSDT" :
     str.contains(tkr, "NQ") or str.contains(tkr, "NAS") or str.contains(tkr, "US100") ? "TVC:SPX" :
     str.contains(tkr, "SPX") or str.contains(tkr, "US500") or str.contains(tkr, "ES1") ? "TVC:NDQ" :
     str.contains(tkr, "YM") or str.contains(tkr, "US30") or str.contains(tkr, "DJI") ? "TVC:SPX" :
     isFx ? "TVC:DXY" : ""
// для форекса DXY зеркалит всё, где USD стоит второй валютой (EURUSD, GBPUSD…)
autoInv = isFx and syminfo.currency == "USD"

smtPair = smtSym == "" ? autoSym : smtSym
smtInv  = smtSym == "" ? autoInv : smtInverse
smtOn   = smtPair != ""
[cHigh, cLow] = request.security(smtPair == "" ? syminfo.tickerid : smtPair, timeframe.period, [high, low], lookahead = barmerge.lookahead_off)

// ============================ ЗОНЫ НАЛОЖЕНИЯ =================================
addOvl(float top, float bot, bool isBull) =>
    col = isBull ? cOvlB : cOvlS
    o = Ovl.new(top = top, bot = bot, bull = isBull, born = bar_index)
    o.bx := box.new(time, top, time + padMs, bot, xloc = xloc.bar_time,
         border_color = color.new(col, 0), border_width = 2,
         bgcolor = fillMode == "Заливка" ? col : color.new(col, math.min(99, color.t(col) + 35)))
    if ovlText
        o.lb := label.new(time + padMs, (top + bot) / 2, "2×FVG", xloc = xloc.bar_time,
             style = label.style_label_left, color = color.new(col, 20), textcolor = color.white, size = size.tiny)
    array.push(ovls, o)
    array.set(ovlCount, 0, array.get(ovlCount, 0) + 1)
    while array.size(ovls) > ovlKeep
        old = array.shift(ovls)
        box.delete(old.bx)
        label.delete(old.lb)
    0

// ищем пару для только что найденного FVG (сам он ещё не в массиве)
tryOverlap(Fvg f) =>
    if showOvl and array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            g = array.get(fvgs, i)
            if g.bull == f.bull
                if g.htf != f.htf
                    t = math.min(f.top, g.top)
                    b = math.max(f.bot, g.bot)
                    if t - b > atr * ovlMinAtr
                        addOvl(t, b, f.bull)
    0

// ================================ FVG ========================================
trimFvg(bool isBull, bool isHtf) =>
    lim = isHtf ? htfKeep : ltfKeep
    cnt = 0
    if array.size(fvgs) > 0
        for i = array.size(fvgs) - 1 to 0
            f = array.get(fvgs, i)
            if f.bull == isBull and f.htf == isHtf
                cnt += 1
                if cnt > lim
                    killFvg(f)
                    array.remove(fvgs, i)
    0

addFvg(float top, float bot, bool isBull, bool isHtf, int anchor) =>
    minSz  = (isHtf ? nz(hAtr, atr) : atr) * (isHtf ? htfMinAtr : ltfMinAtr)
    doDraw = isHtf ? showHtf : showLtf
    if top - bot > minSz and top > bot
        base = isBull ? cBull : cBear
        col  = isHtf ? base : color.new(base, math.min(99, color.t(base) + dimLtf))
        f = Fvg.new(top = top, bot = bot, bull = isBull, htf = isHtf, born = bar_index)
        if doDraw
            color fill = fillMode == "Заливка" ? col : na
            f.bx := box.new(anchor, top, time + padMs, bot, xloc = xloc.bar_time,
                 border_color = color.new(base, isHtf ? 15 : 40), border_width = isHtf ? 2 : 1,
                 border_style = isHtf ? line.style_solid : line.style_dashed, bgcolor = fill)
            if showEdges
                f.lnT := line.new(anchor, top, time + padMs, top, xloc = xloc.bar_time, color = color.new(base, 25), width = isHtf ? 2 : 1)
                f.lnB := line.new(anchor, bot, time + padMs, bot, xloc = xloc.bar_time, color = color.new(base, 25), width = isHtf ? 2 : 1)
            if showCE
                f.lnC := line.new(anchor, (top + bot) / 2, time + padMs, (top + bot) / 2, xloc = xloc.bar_time, color = color.new(base, 40), style = line.style_dotted)
        tryOverlap(f)
        array.push(fvgs, f)
        trimFvg(isBull, isHtf)
    0

// --- новые FVG 5m (только по закрытому бару анализа) ---
if inWindow and newHtfBar and barstate.isconfirmed
    if not na(hBullTop)
        addFvg(hBullTop, hBullBot, true, true, hAnchor)
    if not na(hBearTop)
        addFvg(hBearTop, hBearBot, false, true, hAnchor)

// --- новые FVG графика ---
ltfBull = low > high[2]
ltfBear = high < low[2]
if inWindow and barstate.isconfirmed and ltfBull
    addFvg(low, high[2], true, false, time[2])
if inWindow and barstate.isconfirmed and ltfBear
    addFvg(low[2], high, false, false, time[2])

// --------------------- продление и снятие FVG --------------------------------
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        f = array.get(fvgs, i)
        rEdge = time + padMs
        box.set_right(f.bx, rEdge)
        line.set_x2(f.lnT, rEdge)
        line.set_x2(f.lnB, rEdge)
        line.set_x2(f.lnC, rEdge)
        life    = f.htf ? htfLife : ltfLife
        expired = life > 0 and bar_index - f.born > life
        broken  = f.bull ? close < f.bot : close > f.top
        if expired or broken
            killFvg(f)
            array.remove(fvgs, i)

// --------------------- продление и снятие зон GAP ----------------------------
if array.size(ovls) > 0
    for i = array.size(ovls) - 1 to 0
        o = array.get(ovls, i)
        box.set_right(o.bx, time + padMs)
        if not na(o.lb)
            label.set_x(o.lb, time + padMs)
        gone = (o.bull ? close < o.bot : close > o.top) or (ovlLife > 0 and bar_index - o.born > ovlLife)
        if gone
            box.delete(o.bx)
            label.delete(o.lb)
            array.remove(ovls, i)

// ========================= ЛИКВИДНОСТЬ И СВИПЫ ===============================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

trimLiq(bool isHigh) =>
    cnt = 0
    if array.size(liqs) > 0
        for i = array.size(liqs) - 1 to 0
            q = array.get(liqs, i)
            if q.isHigh == isHigh and not q.taken and q.tag == ""
                cnt += 1
                if cnt > liqKeep
                    killLiq(q)
                    array.remove(liqs, i)
    0

addLiq(float price, float ch, float cl, bool isHigh, int backBars, string tag) =>
    q = Liq.new(price = price, isHigh = isHigh, compH = ch, compL = cl, bar = bar_index - backBars,
         taken = false, takenBar = na, tag = tag)
    key = tag != ""
    if showLiq or key
        q.ln := line.new(bar_index - backBars, price, bar_index, price,
             color = key ? cKey : cLiq, style = key ? line.style_solid : line.style_dashed, width = key ? 2 : 1)
        if key
            q.tg := label.new(bar_index, price, tag, style = label.style_label_left,
                 color = color.new(cKey, 85), textcolor = cKey, size = size.tiny)
    array.push(liqs, q)
    trimLiq(isHigh)
    0

if inWindow and not na(ph)
    addLiq(ph, cHigh[pivotLen], cLow[pivotLen], true, pivotLen, "")
if inWindow and not na(pl)
    addLiq(pl, cHigh[pivotLen], cLow[pivotLen], false, pivotLen, "")

// убираем уровни, которые так и не сняли за отведённое время
if liqLife > 0 and array.size(liqs) > 0
    for i = array.size(liqs) - 1 to 0
        q = array.get(liqs, i)
        if not q.taken and q.tag == "" and bar_index - q.bar > liqLife
            line.delete(q.ln)
            label.delete(q.lb)
            array.remove(liqs, i)

var int   swLowBar    = na
var float swLowPrice  = na
var bool  swLowSmt    = false
var int   swHighBar   = na
var float swHighPrice = na
var bool  swHighSmt   = false
var int  lastSweepBar  = na
var bool lastSweepHigh = false
var bool lastSweepSmt  = false
sweptHigh = false
sweptLow  = false
smtHigh   = false
smtLow    = false

if array.size(liqs) > 0
    for i = array.size(liqs) - 1 to 0
        q = array.get(liqs, i)
        if not q.taken
            if not na(q.ln)
                line.set_x2(q.ln, bar_index)
            if not na(q.tg)
                label.set_x(q.tg, bar_index)
            hit = q.isHigh ? (high > q.price and close < q.price) : (low < q.price and close > q.price)
            if hit and inSession
                q.taken    := true
                q.takenBar := bar_index
                lastSweepBar  := bar_index
                lastSweepHigh := q.isHigh
                // SMT: связанный инструмент свой зеркальный уровень НЕ снял.
                // при инверсной корреляции максимуму здесь соответствует минимум там
                mirrorHigh = smtInv ? not q.isHigh : q.isHigh
                divergence = smtOn and (mirrorHigh ? cHigh <= q.compH : cLow >= q.compL)
                lastSweepSmt := divergence
                if q.isHigh
                    sweptHigh   := true
                    smtHigh     := divergence
                    swHighBar   := bar_index
                    swHighPrice := high
                    swHighSmt   := divergence
                else
                    sweptLow   := true
                    smtLow     := divergence
                    swLowBar   := bar_index
                    swLowPrice := low
                    swLowSmt   := divergence
                if not na(q.ln)
                    line.set_color(q.ln, cSweep)
                    line.set_style(q.ln, line.style_solid)
                    line.set_width(q.ln, 2)
                showIt = showSweep or (divergence and showSmt)
                if showIt
                    txt = (q.isHigh ? "SWEEP ↑ BSL" : "SWEEP ↓ SSL") + (divergence and showSmt ? "  ·  SMT" : "")
                    q.lb := label.new(bar_index, q.isHigh ? high : low, txt,
                         style = q.isHigh ? label.style_label_down : label.style_label_up,
                         color = divergence and showSmt ? color.new(cSmt, 0) : color.new(cSweep, 0),
                         textcolor = divergence and showSmt ? color.black : color.white,
                         size = size.small,
                         tooltip = "Снята ликвидность " + str.tostring(q.price, format.mintick) +
                         (divergence ? "\nSMT: " + smtPair + " свой уровень не снял" : ""))
                if divergence and showSmt
                    if not na(q.ln)
                        line.set_color(q.ln, cSmt)
                    if smtLine
                        sln = line.new(q.bar, q.price, bar_index, q.price, color = cSmt, style = line.style_solid, width = 3)
                        array.push(smtLines, sln)
                        slb = label.new(int((q.bar + bar_index) / 2), q.price, "SMT", xloc = xloc.bar_index,
                             style = label.style_none, textcolor = cSmt, size = size.small)
                        array.push(smtLbls, slb)
        else
            if sweepKeep > 0 and not na(q.takenBar) and bar_index - q.takenBar > sweepKeep
                killLiq(q)
                array.remove(liqs, i)

// жёсткий потолок на снятые уровни, чтобы не упереться в лимит объектов
while array.size(liqs) > 80
    killLiq(array.shift(liqs))

while array.size(smtLbls) > 30
    label.delete(array.shift(smtLbls))
while array.size(smtLines) > 30
    line.delete(array.shift(smtLines))


// ========================= СКОЛЬЗЯЩИЕ СРЕДНИЕ ================================
// все типы считаются в теле функции (то есть на каждом баре), выбор — уже готовым
maOf(string t, int len) =>
    sma = ta.sma(close, len)
    ema = ta.ema(close, len)
    t == "SMA" ? sma : ema

ma1 = request.security(syminfo.tickerid, ma1TF == "" ? timeframe.period : ma1TF, maOf(ma1Type, ma1Len), lookahead = barmerge.lookahead_off)
ma2 = request.security(syminfo.tickerid, ma2TF == "" ? timeframe.period : ma2TF, maOf(ma2Type, ma2Len), lookahead = barmerge.lookahead_off)

pMa1 = plot(ma1On ? ma1 : na, "MA 1", color = ma1Col, linewidth = 2)
pMa2 = plot(ma2On ? ma2 : na, "MA 2", color = ma2Col, linewidth = 2)
fill(pMa1, pMa2, color = maFill and ma1On and ma2On ? color.new(ma1 > ma2 ? cBull : cBear, 88) : na, title = "Облако MA")

maCrossUp = ma1On and ma2On and ta.crossover(ma1, ma2)
maCrossDn = ma1On and ma2On and ta.crossunder(ma1, ma2)
plotshape(maCrossUp ? ma1 : na, "Пересечение MA вверх", shape.circle, location.absolute, color.new(cBull, 0), size = size.tiny)
plotshape(maCrossDn ? ma1 : na, "Пересечение MA вниз",  shape.circle, location.absolute, color.new(cBear, 0), size = size.tiny)

// =============================== КИЛЗОНЫ =====================================
inAsiaKz = not na(time(timeframe.period, kzAsiaS, kzTz))
inLonKz  = not na(time(timeframe.period, kzLonS,  kzTz))
inNyKz   = not na(time(timeframe.period, kzNyS,   kzTz))
inKz = switch kzUse
    "Лондон + Нью-Йорк" => inLonKz or inNyKz
    "Только Лондон"     => inLonKz
    "Только Нью-Йорк"   => inNyKz
    => inAsiaKz or inLonKz or inNyKz
bgcolor(kzOn and inAsiaKz ? kzAsiaC : na, title = "Килзона Азия")
bgcolor(kzOn and inLonKz  ? kzLonC  : na, title = "Килзона Лондон")
bgcolor(kzOn and inNyKz   ? kzNyC   : na, title = "Килзона Нью-Йорк")

// ========================== КЛЮЧЕВЫЕ УРОВНИ ==================================
// предыдущий день / неделя берём с lookahead_on по закрытым периодам — это
// штатный непererрисовывающий способ получить PDH/PDL
[pdh, pdl, dOpen] = request.security(syminfo.tickerid, "D", [high[1], low[1], open], lookahead = barmerge.lookahead_on)
[pwh, pwl]        = request.security(syminfo.tickerid, "W", [high[1], low[1]],       lookahead = barmerge.lookahead_on)
[cdh, cdl]        = request.security(smtPair == "" ? syminfo.tickerid : smtPair, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[cwh, cwl]        = request.security(smtPair == "" ? syminfo.tickerid : smtPair, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

newWeek = ta.change(time("W")) != 0

if inWindow and newDay and lvlPD and not na(pdh)
    addLiq(pdh, cdh, cdl, true,  0, "PDH")
    addLiq(pdl, cdh, cdl, false, 0, "PDL")
if inWindow and newWeek and lvlPW and not na(pwh)
    addLiq(pwh, cwh, cwl, true,  0, "PWH")
    addLiq(pwl, cwh, cwl, false, 0, "PWL")

// открытие дня — просто ориентир, в свипы не идёт
var line doLn = na
var label doLb = na
if lvlDO and newDay
    line.delete(doLn)
    label.delete(doLb)
    doLn := line.new(bar_index, dOpen, bar_index + 1, dOpen, color = color.new(cKey, 45), style = line.style_dotted, width = 1)
    doLb := label.new(bar_index, dOpen, "открытие дня", style = label.style_label_left, color = color.new(cKey, 90), textcolor = color.new(cKey, 25), size = size.tiny)
if not na(doLn)
    line.set_x2(doLn, bar_index)
    label.set_x(doLb, bar_index)

// --------------------------- диапазон Азии -----------------------------------
var float asiaH    = na
var float asiaL    = na
var int   asiaBar  = na
var box   asiaBx   = na
if inAsiaKz
    if not inAsiaKz[1]
        asiaH   := high
        asiaL   := low
        asiaBar := bar_index
        if lvlBox
            box.delete(asiaBx)
            asiaBx := box.new(bar_index, high, bar_index, low, border_color = color.new(cKey, 55), border_width = 1, bgcolor = color.new(cKey, 93))
    else
        asiaH := math.max(asiaH, high)
        asiaL := math.min(asiaL, low)
    if not na(asiaBx)
        box.set_top(asiaBx, asiaH)
        box.set_bottom(asiaBx, asiaL)
        box.set_right(asiaBx, bar_index)
// сессия закрылась — фиксируем хай и лоу как ликвидность
if lvlAsia and not inAsiaKz and inAsiaKz[1] and not na(asiaH)
    addLiq(asiaH, cHigh, cLow, true,  bar_index - asiaBar, "Asia H")
    addLiq(asiaL, cHigh, cLow, false, bar_index - asiaBar, "Asia L")

// ========================== СТРУКТУРА: BOS / CHoCH ===========================
var float structH    = na
var float structL    = na
var int   structHBar = na
var int   structLBar = na
var int   trendDir   = 0
var array<line>  stLines = array.new<line>()
var array<label> stLbls  = array.new<label>()

if not na(ph)
    structH    := ph
    structHBar := bar_index - pivotLen
if not na(pl)
    structL    := pl
    structLBar := bar_index - pivotLen

brokeUp = not na(structH) and close > structH and close[1] <= structH
brokeDn = not na(structL) and close < structL and close[1] >= structL

markStruct(float lvl, int fromBar, bool up, string txt) =>
    col = up ? cBull : cBear
    ln = line.new(fromBar, lvl, bar_index, lvl, color = color.new(col, 20), style = line.style_dashed, width = 1)
    lb = label.new(bar_index, lvl, txt, style = up ? label.style_label_up : label.style_label_down,
         color = color.new(col, 25), textcolor = color.white, size = size.tiny)
    array.push(stLines, ln)
    array.push(stLbls, lb)
    while array.size(stLines) > structKeep
        line.delete(array.shift(stLines))
    while array.size(stLbls) > structKeep
        label.delete(array.shift(stLbls))
    0

chochUp = false
chochDn = false
if brokeUp
    chochUp := trendDir == -1
    if structOn
        markStruct(structH, structHBar, true, chochUp ? "CHoCH" : "BOS")
    trendDir := 1
    structH  := na
if brokeDn
    chochDn := trendDir == 1
    if structOn
        markStruct(structL, structLBar, false, chochDn ? "CHoCH" : "BOS")
    trendDir := -1
    structL  := na

// ========================= ГОТОВНОСТЬ К ВХОДУ ================================
// 1. цена сейчас внутри бычьей / медвежьей зоны?
inZoneL = false
inZoneS = false
float zLBot = na
float zSTop = na
if array.size(ovls) > 0
    for i = 0 to array.size(ovls) - 1
        o = array.get(ovls, i)
        if low <= o.top and high >= o.bot
            if o.bull
                inZoneL := true
                zLBot := na(zLBot) ? o.bot : math.min(zLBot, o.bot)
            else
                inZoneS := true
                zSTop := na(zSTop) ? o.top : math.max(zSTop, o.top)
if array.size(fvgs) > 0
    for i = 0 to array.size(fvgs) - 1
        f = array.get(fvgs, i)
        if f.htf and low <= f.top and high >= f.bot
            if f.bull
                inZoneL := true
                zLBot := na(zLBot) ? f.bot : math.min(zLBot, f.bot)
            else
                inZoneS := true
                zSTop := na(zSTop) ? f.top : math.max(zSTop, f.top)

// 2. реакция на текущем ТФ: свежий FVG графика или дисплейсмент-свеча
bodyAbs = math.abs(close - open)
dispUp  = bodyAbs > atr * dispMult and close > open
dispDn  = bodyAbs > atr * dispMult and close < open
reactL  = nz(ta.barssince(ltfBull), 9999) <= reactWin or dispUp
reactS  = nz(ta.barssince(ltfBear), 9999) <= reactWin or dispDn

// 3. свежесть свипа и SMT на нём
swFreshL  = not na(swLowBar)  and bar_index - swLowBar  <= entryWin
swFreshS  = not na(swHighBar) and bar_index - swHighBar <= entryWin
smtFreshL = swFreshL and swLowSmt
smtFreshS = swFreshS and swHighSmt

// 4. байас по скользящим
biasOn = ma1On and ma2On
biasL  = biasOn and ma1 > ma2
biasS  = biasOn and ma1 < ma2

// 5. структура: пробой в нужную сторону уже был
structUp = trendDir == 1
structDn = trendDir == -1

scoreL = (swFreshL ? 1 : 0) + (smtFreshL ? 1 : 0) + (inZoneL ? 1 : 0) + (reactL ? 1 : 0) + (biasL ? 1 : 0) + (inKz ? 1 : 0) + (structUp ? 1 : 0)
scoreS = (swFreshS ? 1 : 0) + (smtFreshS ? 1 : 0) + (inZoneS ? 1 : 0) + (reactS ? 1 : 0) + (biasS ? 1 : 0) + (inKz ? 1 : 0) + (structDn ? 1 : 0)

kzOk   = not kzHard or inKz
readyL = entryOn and inSession and kzOk and scoreL >= needScore and scoreL >= scoreS
readyS = entryOn and inSession and kzOk and scoreS >= needScore and scoreS > scoreL
newL   = readyL and not readyL[1]
newS   = readyS and not readyS[1]

// ------------------------- активный сетап и его уровни -----------------------
var int   sDir   = 0
var float sEntry = na
var float sSl    = na
var float sTp1   = na
var float sTp2   = na
var line  lnE    = na
var line  lnSl   = na
var line  lnT1   = na
var line  lnT2   = na
var label lbSet  = na
var array<line>  setLines = array.new<line>()
var array<label> setLbls  = array.new<label>()
var int nSetup = 0
var int nWin   = 0
var int nLoss  = 0

// функция только создаёт объекты и отдаёт их наружу — писать в глобальные
// переменные из тела функции Pine не разрешает
mkSetup(bool isLong, float en, float sl, float t1, float t2) =>
    col = isLong ? cBull : cBear
    x2  = bar_index + 5
    a = line.new(bar_index, en, x2, en, color = color.new(color.white, 20), width = 1)
    b = line.new(bar_index, sl, x2, sl, color = color.new(color.red, 10), style = line.style_dashed, width = 1)
    c = line.new(bar_index, t1, x2, t1, color = color.new(color.green, 10), style = line.style_dashed, width = 1)
    d = line.new(bar_index, t2, x2, t2, color = color.new(color.green, 45), style = line.style_dotted, width = 1)
    e = label.new(x2, en, (isLong ? "LONG " : "SHORT ") + str.tostring(rr1, "#.#") + "R",
         style = label.style_label_left, color = color.new(col, 15), textcolor = color.white, size = size.tiny)
    array.push(setLines, a)
    array.push(setLines, b)
    array.push(setLines, c)
    array.push(setLines, d)
    array.push(setLbls, e)
    while array.size(setLines) > keepSetups * 4
        line.delete(array.shift(setLines))
    while array.size(setLbls) > keepSetups
        label.delete(array.shift(setLbls))
    [a, b, c, d, e]

if newL and sDir == 0
    sDir   := 1
    sEntry := close
    stopRef = na(zLBot) ? nz(swLowPrice, low) : math.min(zLBot, nz(swLowPrice, low))
    sSl    := math.min(stopRef, low) - atr * slPad
    rDist  = math.max(sEntry - sSl, syminfo.mintick)
    sTp1   := sEntry + rDist * rr1
    sTp2   := sEntry + rDist * rr2
    nSetup += 1
    if showSetup
        [a, b, c, d, e] = mkSetup(true, sEntry, sSl, sTp1, sTp2)
        lnE   := a
        lnSl  := b
        lnT1  := c
        lnT2  := d
        lbSet := e

if newS and sDir == 0
    sDir   := -1
    sEntry := close
    stopRef = na(zSTop) ? nz(swHighPrice, high) : math.max(zSTop, nz(swHighPrice, high))
    sSl    := math.max(stopRef, high) + atr * slPad
    rDist  = math.max(sSl - sEntry, syminfo.mintick)
    sTp1   := sEntry - rDist * rr1
    sTp2   := sEntry - rDist * rr2
    nSetup += 1
    if showSetup
        [a, b, c, d, e] = mkSetup(false, sEntry, sSl, sTp1, sTp2)
        lnE   := a
        lnSl  := b
        lnT1  := c
        lnT2  := d
        lbSet := e

// тянем уровни активного сетапа и считаем исход
hitSl = false
hitTp = false
if sDir != 0
    if not na(lnE)
        line.set_x2(lnE,  bar_index + 5)
        line.set_x2(lnSl, bar_index + 5)
        line.set_x2(lnT1, bar_index + 5)
        line.set_x2(lnT2, bar_index + 5)
        label.set_x(lbSet, bar_index + 5)
    if sDir == 1
        if low <= sSl
            hitSl := true
        else if high >= sTp1
            hitTp := true
    else
        if high >= sSl
            hitSl := true
        else if low <= sTp1
            hitTp := true
    if hitSl or hitTp
        if hitSl
            nLoss += 1
        else
            nWin += 1
        if not na(lbSet)
            label.set_text(lbSet, hitTp ? "TP" : "SL")
            label.set_color(lbSet, color.new(hitTp ? cBull : cBear, 15))
        sDir := 0

// =============================== АЛЕРТЫ ======================================
newGap = ta.change(array.get(ovlCount, 0)) > 0
alertcondition(newGap,    "GAP: два FVG на одном уровне", "GAP (2×FVG) {{ticker}} {{interval}} @ {{close}}")
alertcondition(sweptHigh, "Свип максимумов (BSL)",        "Снята ликвидность сверху {{ticker}} {{interval}} @ {{close}}")
alertcondition(sweptLow,  "Свип минимумов (SSL)",         "Снята ликвидность снизу {{ticker}} {{interval}} @ {{close}}")
alertcondition(smtHigh,   "SMT на максимумах",            "Медвежий SMT {{ticker}} {{interval}} @ {{close}}")
alertcondition(smtLow,    "SMT на минимумах",             "Бычий SMT {{ticker}} {{interval}} @ {{close}}")
alertcondition(maCrossUp, "MA 1 пересекла MA 2 вверх",    "MA вверх {{ticker}} {{interval}} @ {{close}}")
alertcondition(maCrossDn, "MA 1 пересекла MA 2 вниз",     "MA вниз {{ticker}} {{interval}} @ {{close}}")
alertcondition(newL,      "Готовность к входу LONG",      "Готов вход LONG {{ticker}} {{interval}} @ {{close}}")
alertcondition(newS,      "Готовность к входу SHORT",     "Готов вход SHORT {{ticker}} {{interval}} @ {{close}}")
alertcondition(chochUp,   "CHoCH вверх",                  "Слом структуры вверх {{ticker}} {{interval}} @ {{close}}")
alertcondition(chochDn,   "CHoCH вниз",                   "Слом структуры вниз {{ticker}} {{interval}} @ {{close}}")
alertcondition(brokeUp and not chochUp, "BOS вверх",      "BOS вверх {{ticker}} {{interval}} @ {{close}}")
alertcondition(brokeDn and not chochDn, "BOS вниз",       "BOS вниз {{ticker}} {{interval}} @ {{close}}")

// =============================== ПАНЕЛЬ ======================================
countFvg(bool isBull, bool isHtf) =>
    n = 0
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            f = array.get(fvgs, i)
            if f.bull == isBull and f.htf == isHtf
                n += 1
    n

countOvl(bool isBull) =>
    n = 0
    if array.size(ovls) > 0
        for i = 0 to array.size(ovls) - 1
            o = array.get(ovls, i)
            if o.bull == isBull
                n += 1
    n

mk(bool b)  => b ? "✔" : "·"
mkc(bool b) => b ? color.new(#00e676, 0) : color.new(#787b86, 20)

// три вида строк вместо трёх десятков одинаковых table.cell
rowChk(t, r, name, l, s, bg) =>
    table.cell(t, 0, r, name,  bgcolor = bg, text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, r, mk(l), bgcolor = bg, text_color = mkc(l),       text_size = size.tiny)
    table.cell(t, 2, r, mk(s), bgcolor = bg, text_color = mkc(s),       text_size = size.tiny)
    0

rowNum(t, r, name, l, s, bg, cl, cs) =>
    table.cell(t, 0, r, name, bgcolor = bg, text_color = color.silver, text_size = size.tiny)
    table.cell(t, 1, r, str.tostring(l), bgcolor = bg, text_color = cl, text_size = size.tiny)
    table.cell(t, 2, r, str.tostring(s), bgcolor = bg, text_color = cs, text_size = size.tiny)
    0

rowWide(t, r, txt, bg, fg) =>
    table.cell(t, 0, r, txt, bgcolor = bg, text_color = fg, text_size = size.tiny)
    table.cell(t, 1, r, "",  bgcolor = bg)
    table.cell(t, 2, r, "",  bgcolor = bg)
    table.merge_cells(t, 0, r, 2, r)
    0

if showPanel and barstate.islast
    pos = switch panelPos
        "Справа сверху" => position.top_right
        "Слева сверху"  => position.top_left
        "Справа снизу"  => position.bottom_right
        => position.bottom_left
    var table tb = table.new(position.top_right, 3, 16, border_width = 1)
    table.set_position(tb, pos)
    hd = color.new(#1e222d, 5)
    cl = color.new(#1e222d, 25)

    table.cell(tb, 0, 0, "FVG SNIPER", bgcolor = hd, text_color = color.white,        text_size = size.small)
    table.cell(tb, 1, 0, "▲",          bgcolor = hd, text_color = color.new(cBull, 0), text_size = size.small)
    table.cell(tb, 2, 0, "▼",          bgcolor = hd, text_color = color.new(cBear, 0), text_size = size.small)

    nB = countOvl(true)
    nS = countOvl(false)
    rowNum(tb, 1, "FVG " + htfTF + "m",      countFvg(true, true),  countFvg(false, true),  cl, color.white, color.white)
    rowNum(tb, 2, "FVG " + timeframe.period, countFvg(true, false), countFvg(false, false), cl, color.white, color.white)
    rowNum(tb, 3, "GAP · 2×FVG", nB, nS, cl,
         nB > 0 ? color.new(cOvlB, 0) : color.gray, nS > 0 ? color.new(cOvlS, 0) : color.gray)

    rowWide(tb, 4, "ЧЕК-ЛИСТ", hd, color.white)
    pairTxt = str.replace_all(str.replace_all(str.replace_all(smtPair, "TVC:", ""), "BINANCE:", ""), "CME_MINI:", "")
    kzTxt = inAsiaKz ? "килзона · Азия" : (inLonKz ? "килзона · Лондон" : (inNyKz ? "килзона · Нью-Йорк" : "килзона · вне"))
    stTxt = trendDir == 0 ? "структура · нет" : (trendDir == 1 ? "структура · вверх" : "структура · вниз")
    rowChk(tb, 5, "свип", swFreshL, swFreshS, cl)
    rowChk(tb, 6, smtOn ? "SMT · " + pairTxt + (smtInv ? " инв." : "") : "SMT · нет пары", smtFreshL, smtFreshS, cl)
    rowChk(tb, 7, "цена в зоне", inZoneL, inZoneS, cl)
    rowChk(tb, 8, "реакция " + timeframe.period, reactL, reactS, cl)
    rowChk(tb, 9, biasOn ? "байас MA" : "байас MA (выкл)", biasL, biasS, cl)
    rowChk(tb, 10, kzTxt, inKz, inKz, cl)
    rowChk(tb, 11, stTxt, structUp, structDn, cl)

    table.cell(tb, 0, 12, "ГОТОВНОСТЬ", bgcolor = hd, text_color = color.white, text_size = size.tiny)
    table.cell(tb, 1, 12, str.tostring(scoreL) + "/" + str.tostring(needScore), bgcolor = hd,
         text_color = readyL ? color.new(cBull, 0) : color.silver, text_size = size.tiny)
    table.cell(tb, 2, 12, str.tostring(scoreS) + "/" + str.tostring(needScore), bgcolor = hd,
         text_color = readyS ? color.new(cBear, 0) : color.silver, text_size = size.tiny)

    setupTxt = sDir == 0 ? "активного сетапа нет" :
         (sDir == 1 ? "LONG " : "SHORT ") + str.tostring(sEntry, format.mintick) +
         "  SL " + str.tostring(sSl, format.mintick) + "  TP " + str.tostring(sTp1, format.mintick)
    rowWide(tb, 13, setupTxt, cl, sDir == 0 ? color.gray : (sDir == 1 ? color.new(cBull, 0) : color.new(cBear, 0)))

    closed  = nWin + nLoss
    statTxt = nSetup == 0 ? "сетапов ещё не было" :
         str.tostring(nSetup) + " сетапов · TP " + str.tostring(nWin) + " · SL " + str.tostring(nLoss) +
         (closed > 0 ? "  →  " + str.tostring(math.round(nWin * 100.0 / closed)) + "%" : "")
    rowWide(tb, 14, statTxt, cl, closed == 0 ? color.silver : (nWin >= nLoss ? color.new(cBull, 0) : color.new(cBear, 0)))

    modeTxt = visMode == "Последние N баров" ? "окно " + str.tostring(histBars) + " бар." : (visMode == "Текущий день" ? "текущий день" : "вся история")
    warnTxt = tfSecHtf <= tfSecChart ? "⚠ ТФ анализа ≤ ТФ графика" : syminfo.ticker + " · " + timeframe.period + " · " + modeTxt
    rowWide(tb, 15, warnTxt, cl, tfSecHtf <= tfSecChart ? color.orange : color.silver)
