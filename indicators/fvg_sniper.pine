//@version=6
// =============================================================================
//  FVG SNIPER — карта имбалансов
// -----------------------------------------------------------------------------
//  Чистый анализ, без сигналов и уровней входа:
//    · FVG таймфрейма анализа (5m) и FVG самого графика (3m)
//    · GAP = наложение двух FVG на одном уровне (5m + 3m) — главная зона
//    · Ликвидность: уровни тянутся вправо, пока их не снимут; свип подписан
//    · SMT-дивергенция против коррелирующего инструмента — рисуется всегда
//
//  График ставим на 3m, "ТФ анализа" оставляем 5.
// =============================================================================
indicator("FVG Sniper", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ================================ ВВОД =======================================
g1 = "1 · FVG таймфрейма анализа"
htfTF      = input.timeframe("5",   "ТФ анализа",                     group = g1)
showHtf    = input.bool(true,       "Показывать FVG 5m",              group = g1)
htfKeep    = input.int(8,           "Хранить на сторону", minval = 1, maxval = 20, group = g1)
htfMinAtr  = input.float(0.10,      "Мин. размер (× ATR)", minval = 0, step = 0.05, group = g1)

g2 = "2 · FVG графика"
showLtf    = input.bool(true,       "Показывать FVG графика (3m)",    group = g2)
ltfKeep    = input.int(12,          "Хранить на сторону", minval = 1, maxval = 30, group = g2)
ltfMinAtr  = input.float(0.05,      "Мин. размер (× ATR)", minval = 0, step = 0.05, group = g2)

g3 = "3 · GAP — два FVG на одном уровне"
showOvl    = input.bool(true,       "Подсвечивать наложение",         group = g3)
ovlMode    = input.string("5m + 3m","Какие пары считать", options = ["5m + 3m", "Любые два", "Только 5m", "Только 3m"], group = g3)
ovlMinAtr  = input.float(0.03,      "Мин. толщина наложения (× ATR)", minval = 0, step = 0.01, group = g3)
ovlKeep    = input.int(10,          "Хранить зон", minval = 1, maxval = 30, group = g3)
ovlText    = input.bool(true,       "Подпись «2×FVG»",                group = g3)

g4 = "4 · Границы и середина"
showEdges  = input.bool(true,       "Линии границ FVG",               group = g4)
showCE     = input.bool(true,       "Линия 50 % (CE)",                group = g4)
invalidMode= input.string("Закрытие за границей", "Снимать FVG при", options = ["Закрытие за границей", "Проколе хвостом", "Достижении 50 %"], group = g4)
keepDead   = input.bool(false,      "Оставлять отработанные (серым)", group = g4)
rightPad   = input.int(6,           "Продлевать зоны вправо, баров", minval = 0, maxval = 100, group = g4)

g5 = "5 · Ликвидность и свипы"
showLiq    = input.bool(true,       "Показывать уровни ликвидности",  group = g5)
pivotLen   = input.int(5,           "Длина пивота", minval = 1, maxval = 50, group = g5)
liqKeep    = input.int(6,           "Уровней на сторону", minval = 1, maxval = 20, group = g5)
showSweep  = input.bool(true,       "Подписывать свипы",              group = g5)
sweepKeep  = input.int(40,          "Держать снятый уровень, баров", minval = 0, maxval = 300, group = g5)

g6 = "6 · SMT-дивергенция"
smtSym     = input.symbol("",       "Коррелирующий инструмент",       group = g6, tooltip = "Без него SMT не считается. Примеры: NQ1! ↔ ES1!, EURUSD ↔ DXY, BTCUSDT ↔ ETHUSDT.")
showSmt    = input.bool(true,       "Показывать SMT",                 group = g6)
smtLine    = input.bool(true,       "Линия от свинга до свипа",       group = g6)

g7 = "7 · Сессия"
useSession = input.bool(false,      "Работать только в сессии",       group = g7)
sessStr    = input.session("0700-1600", "Сессия",                     group = g7)
sessTz     = input.string("UTC",    "Таймзона", options = ["UTC", "America/New_York", "Europe/London", "Europe/Kyiv", "Europe/Moscow", "Asia/Tokyo", "Asia/Shanghai"], group = g7)
showSessBg = input.bool(false,      "Подсветка фона сессии",          group = g7)

g8 = "8 · Оформление"
cBull      = input.color(color.new(#26a69a, 80), "FVG вверх",   group = g8, inline = "a")
cBear      = input.color(color.new(#ef5350, 80), "FVG вниз",    group = g8, inline = "a")
cOvlB      = input.color(color.new(#00e676, 55), "GAP вверх",   group = g8, inline = "b")
cOvlS      = input.color(color.new(#ff1744, 55), "GAP вниз",    group = g8, inline = "b")
cLiq       = input.color(color.new(#787b86, 30), "Ликвидность", group = g8, inline = "c")
cSweep     = input.color(#42a5f5,                "Свип",        group = g8, inline = "c")
cSmt       = input.color(#ffc107,                "SMT",         group = g8, inline = "c")
dimLtf     = input.int(12,          "Прозрачнее FVG графика, %", minval = 0, maxval = 60, group = g8)
showPanel  = input.bool(true,       "Панель",                         group = g8)
panelPos   = input.string("Справа сверху", "Угол панели", options = ["Справа сверху", "Слева сверху", "Справа снизу", "Слева снизу"], group = g8)

// =============================== ТИПЫ ========================================
type Fvg
    float top
    float bot
    bool  bull
    bool  htf
    bool  dead
    box   bx
    line  lnT
    line  lnB
    line  lnC

type Ovl
    float top
    float bot
    bool  bull
    box   bx
    label lb

type Liq
    float price
    bool  isHigh
    float comp
    int   bar
    bool  taken
    int   takenBar
    line  ln
    label lb

var array<Fvg> fvgs = array.new<Fvg>()
var array<Ovl> ovls = array.new<Ovl>()
var array<Liq> liqs = array.new<Liq>()
var array<label> smtLbls = array.new<label>()
var array<line>  smtLines = array.new<line>()
var array<int>   ovlCount = array.new<int>(1, 0)   // счётчик созданных зон GAP

atr       = ta.atr(14)
inSession = not useSession or not na(time(timeframe.period, sessStr, sessTz))
tfMs      = timeframe.in_seconds(timeframe.period) * 1000
padMs     = tfMs * rightPad
tfSecChart= timeframe.in_seconds(timeframe.period)
tfSecHtf  = timeframe.in_seconds(htfTF)

// ============================ ДАННЫЕ 5m ======================================
htfFeed() =>
    bull = low[1] > high[3]
    bear = high[1] < low[3]
    [bull ? low[1] : na, bull ? high[3] : na, bear ? low[3] : na, bear ? high[1] : na, time[2], ta.atr(14)]

[hBullTop, hBullBot, hBearTop, hBearBot, hAnchor, hAtr] =
     request.security(syminfo.tickerid, htfTF, htfFeed(), lookahead = barmerge.lookahead_off)

newHtfBar = not na(hAnchor) and ta.change(hAnchor) != 0

// ======================= КОРРЕЛИРУЮЩИЙ ИНСТРУМЕНТ ============================
smtOn = smtSym != ""
[cHigh, cLow] = request.security(smtSym == "" ? syminfo.tickerid : smtSym, timeframe.period, [high, low], lookahead = barmerge.lookahead_off)

// ============================ ЗОНЫ НАЛОЖЕНИЯ =================================
addOvl(float top, float bot, bool isBull) =>
    col = isBull ? cOvlB : cOvlS
    o = Ovl.new(top = top, bot = bot, bull = isBull)
    o.bx := box.new(time, top, time + padMs, bot, xloc = xloc.bar_time,
         border_color = color.new(col, 0), border_width = 2, bgcolor = col)
    if ovlText
        o.lb := label.new(time + padMs, (top + bot) / 2, "2×FVG", xloc = xloc.bar_time,
             style = label.style_label_left, color = color.new(col, 20), textcolor = color.white, size = size.tiny)
    array.push(ovls, o)
    array.set(ovlCount, 0, array.get(ovlCount, 0) + 1)
    while array.size(ovls) > ovlKeep
        old = array.shift(ovls)
        box.delete(old.bx)
        label.delete(old.lb)
    0

// ищем пару для только что найденного FVG (сам он ещё не в массиве)
tryOverlap(Fvg f) =>
    if showOvl and array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            g = array.get(fvgs, i)
            if not g.dead and g.bull == f.bull
                pairOk = switch ovlMode
                    "5m + 3m"   => g.htf != f.htf
                    "Любые два" => true
                    "Только 5m" => g.htf and f.htf
                    => not g.htf and not f.htf
                if pairOk
                    t = math.min(f.top, g.top)
                    b = math.max(f.bot, g.bot)
                    if t - b > atr * ovlMinAtr
                        addOvl(t, b, f.bull)
    0

// ================================ FVG ========================================
trimFvg(bool isBull, bool isHtf) =>
    lim = isHtf ? htfKeep : ltfKeep
    cnt = 0
    if array.size(fvgs) > 0
        for i = array.size(fvgs) - 1 to 0
            f = array.get(fvgs, i)
            if f.bull == isBull and f.htf == isHtf
                cnt += 1
                if cnt > lim
                    box.delete(f.bx)
                    line.delete(f.lnT)
                    line.delete(f.lnB)
                    line.delete(f.lnC)
                    array.remove(fvgs, i)
    0

addFvg(float top, float bot, bool isBull, bool isHtf, int anchor) =>
    minSz  = (isHtf ? nz(hAtr, atr) : atr) * (isHtf ? htfMinAtr : ltfMinAtr)
    doDraw = isHtf ? showHtf : showLtf
    if top - bot > minSz and top > bot
        base = isBull ? cBull : cBear
        col  = isHtf ? base : color.new(base, math.min(99, color.t(base) + dimLtf))
        f = Fvg.new(top = top, bot = bot, bull = isBull, htf = isHtf, dead = false)
        if doDraw
            f.bx := box.new(anchor, top, time + padMs, bot, xloc = xloc.bar_time,
                 border_color = color.new(base, 45), border_width = isHtf ? 1 : 0, bgcolor = col)
            if showEdges
                f.lnT := line.new(anchor, top, time + padMs, top, xloc = xloc.bar_time, color = color.new(base, 25), width = isHtf ? 2 : 1)
                f.lnB := line.new(anchor, bot, time + padMs, bot, xloc = xloc.bar_time, color = color.new(base, 25), width = isHtf ? 2 : 1)
            if showCE
                f.lnC := line.new(anchor, (top + bot) / 2, time + padMs, (top + bot) / 2, xloc = xloc.bar_time, color = color.new(base, 40), style = line.style_dotted)
        tryOverlap(f)
        array.push(fvgs, f)
        trimFvg(isBull, isHtf)
    0

// --- новые FVG 5m (только по закрытому бару анализа) ---
if newHtfBar and barstate.isconfirmed
    if not na(hBullTop)
        addFvg(hBullTop, hBullBot, true, true, hAnchor)
    if not na(hBearTop)
        addFvg(hBearTop, hBearBot, false, true, hAnchor)

// --- новые FVG графика ---
ltfBull = low > high[2]
ltfBear = high < low[2]
if barstate.isconfirmed and ltfBull
    addFvg(low, high[2], true, false, time[2])
if barstate.isconfirmed and ltfBear
    addFvg(low[2], high, false, false, time[2])

// --------------------- продление и снятие FVG --------------------------------
if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        f = array.get(fvgs, i)
        if not f.dead
            rEdge = time + padMs
            if not na(f.bx)
                box.set_right(f.bx, rEdge)
            if not na(f.lnT)
                line.set_x2(f.lnT, rEdge)
            if not na(f.lnB)
                line.set_x2(f.lnB, rEdge)
            if not na(f.lnC)
                line.set_x2(f.lnC, rEdge)
            ce = (f.top + f.bot) / 2
            broken = switch invalidMode
                "Закрытие за границей" => f.bull ? close < f.bot : close > f.top
                "Проколе хвостом"      => f.bull ? low   < f.bot : high  > f.top
                => f.bull ? low <= ce : high >= ce
            if broken
                f.dead := true
                if keepDead
                    if not na(f.bx)
                        box.set_bgcolor(f.bx, color.new(color.gray, 92))
                        box.set_border_color(f.bx, color.new(color.gray, 75))
                    line.delete(f.lnT)
                    line.delete(f.lnB)
                    line.delete(f.lnC)
                    f.lnT := na
                    f.lnB := na
                    f.lnC := na
                else
                    box.delete(f.bx)
                    line.delete(f.lnT)
                    line.delete(f.lnB)
                    line.delete(f.lnC)
                    array.remove(fvgs, i)

// --------------------- продление и снятие зон GAP ----------------------------
if array.size(ovls) > 0
    for i = array.size(ovls) - 1 to 0
        o = array.get(ovls, i)
        box.set_right(o.bx, time + padMs)
        if not na(o.lb)
            label.set_x(o.lb, time + padMs)
        gone = o.bull ? close < o.bot : close > o.top
        if gone
            box.delete(o.bx)
            label.delete(o.lb)
            array.remove(ovls, i)

// ========================= ЛИКВИДНОСТЬ И СВИПЫ ===============================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

trimLiq(bool isHigh) =>
    cnt = 0
    if array.size(liqs) > 0
        for i = array.size(liqs) - 1 to 0
            q = array.get(liqs, i)
            if q.isHigh == isHigh and not q.taken
                cnt += 1
                if cnt > liqKeep
                    line.delete(q.ln)
                    label.delete(q.lb)
                    array.remove(liqs, i)
    0

addLiq(float price, float comp, bool isHigh) =>
    q = Liq.new(price = price, isHigh = isHigh, comp = comp, bar = bar_index - pivotLen, taken = false, takenBar = na)
    if showLiq
        q.ln := line.new(bar_index - pivotLen, price, bar_index, price, color = cLiq, style = line.style_dashed, width = 1)
    array.push(liqs, q)
    trimLiq(isHigh)
    0

if not na(ph)
    addLiq(ph, cHigh[pivotLen], true)
if not na(pl)
    addLiq(pl, cLow[pivotLen], false)

var int  lastSweepBar  = na
var bool lastSweepHigh = false
var bool lastSweepSmt  = false
sweptHigh = false
sweptLow  = false
smtHigh   = false
smtLow    = false

if array.size(liqs) > 0
    for i = array.size(liqs) - 1 to 0
        q = array.get(liqs, i)
        if not q.taken
            if not na(q.ln)
                line.set_x2(q.ln, bar_index)
            hit = q.isHigh ? (high > q.price and close < q.price) : (low < q.price and close > q.price)
            if hit and inSession
                q.taken    := true
                q.takenBar := bar_index
                lastSweepBar  := bar_index
                lastSweepHigh := q.isHigh
                // SMT: коррелирующий инструмент свой уровень НЕ снял
                divergence = smtOn and (q.isHigh ? cHigh <= q.comp : cLow >= q.comp)
                lastSweepSmt := divergence
                if q.isHigh
                    sweptHigh := true
                    smtHigh   := divergence
                else
                    sweptLow := true
                    smtLow   := divergence
                if not na(q.ln)
                    line.set_color(q.ln, cSweep)
                    line.set_style(q.ln, line.style_solid)
                    line.set_width(q.ln, 2)
                showIt = showSweep or (divergence and showSmt)
                if showIt
                    txt = (q.isHigh ? "SWEEP ↑ BSL" : "SWEEP ↓ SSL") + (divergence and showSmt ? "  ·  SMT" : "")
                    q.lb := label.new(bar_index, q.isHigh ? high : low, txt,
                         style = q.isHigh ? label.style_label_down : label.style_label_up,
                         color = divergence and showSmt ? color.new(cSmt, 0) : color.new(cSweep, 0),
                         textcolor = divergence and showSmt ? color.black : color.white,
                         size = size.small,
                         tooltip = "Снята ликвидность " + str.tostring(q.price, format.mintick) +
                         (divergence ? "\nSMT: " + smtSym + " свой уровень не снял" : ""))
                if divergence and showSmt
                    if not na(q.ln)
                        line.set_color(q.ln, cSmt)
                    if smtLine
                        sln = line.new(q.bar, q.price, bar_index, q.price, color = cSmt, style = line.style_solid, width = 3)
                        array.push(smtLines, sln)
                        slb = label.new(int((q.bar + bar_index) / 2), q.price, "SMT", xloc = xloc.bar_index,
                             style = label.style_none, textcolor = cSmt, size = size.small)
                        array.push(smtLbls, slb)
        else
            if sweepKeep > 0 and not na(q.takenBar) and bar_index - q.takenBar > sweepKeep
                line.delete(q.ln)
                label.delete(q.lb)
                array.remove(liqs, i)

// жёсткий потолок на снятые уровни, чтобы не упереться в лимит объектов
while array.size(liqs) > 60
    old = array.shift(liqs)
    line.delete(old.ln)
    label.delete(old.lb)

while array.size(smtLbls) > 30
    label.delete(array.shift(smtLbls))
while array.size(smtLines) > 30
    line.delete(array.shift(smtLines))

bgcolor(showSessBg and useSession and inSession ? color.new(color.blue, 94) : na, title = "Сессия")

// =============================== АЛЕРТЫ ======================================
newGap = ta.change(array.get(ovlCount, 0)) > 0
alertcondition(newGap,    "GAP: два FVG на одном уровне", "GAP (2×FVG) {{ticker}} {{interval}} @ {{close}}")
alertcondition(sweptHigh, "Свип максимумов (BSL)",        "Снята ликвидность сверху {{ticker}} {{interval}} @ {{close}}")
alertcondition(sweptLow,  "Свип минимумов (SSL)",         "Снята ликвидность снизу {{ticker}} {{interval}} @ {{close}}")
alertcondition(smtHigh,   "SMT на максимумах",            "Медвежий SMT {{ticker}} {{interval}} @ {{close}}")
alertcondition(smtLow,    "SMT на минимумах",             "Бычий SMT {{ticker}} {{interval}} @ {{close}}")

// =============================== ПАНЕЛЬ ======================================
countFvg(bool isBull, bool isHtf) =>
    n = 0
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            f = array.get(fvgs, i)
            if not f.dead and f.bull == isBull and f.htf == isHtf
                n += 1
    n

countOvl(bool isBull) =>
    n = 0
    if array.size(ovls) > 0
        for i = 0 to array.size(ovls) - 1
            o = array.get(ovls, i)
            if o.bull == isBull
                n += 1
    n

if showPanel and barstate.islast
    pos = switch panelPos
        "Справа сверху" => position.top_right
        "Слева сверху"  => position.top_left
        "Справа снизу"  => position.bottom_right
        => position.bottom_left
    var table tb = table.new(position.top_right, 3, 7, border_width = 1)
    table.set_position(tb, pos)
    hd = color.new(#1e222d, 5)
    cl = color.new(#1e222d, 25)

    table.cell(tb, 0, 0, "FVG SNIPER", bgcolor = hd, text_color = color.white,       text_size = size.small)
    table.cell(tb, 1, 0, "▲",          bgcolor = hd, text_color = color.new(cBull, 0), text_size = size.small)
    table.cell(tb, 2, 0, "▼",          bgcolor = hd, text_color = color.new(cBear, 0), text_size = size.small)

    table.cell(tb, 0, 1, "FVG " + htfTF + "m", bgcolor = cl, text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 1, str.tostring(countFvg(true,  true)),  bgcolor = cl, text_color = color.white, text_size = size.tiny)
    table.cell(tb, 2, 1, str.tostring(countFvg(false, true)),  bgcolor = cl, text_color = color.white, text_size = size.tiny)

    table.cell(tb, 0, 2, "FVG " + timeframe.period, bgcolor = cl, text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 2, str.tostring(countFvg(true,  false)), bgcolor = cl, text_color = color.white, text_size = size.tiny)
    table.cell(tb, 2, 2, str.tostring(countFvg(false, false)), bgcolor = cl, text_color = color.white, text_size = size.tiny)

    nB = countOvl(true)
    nS = countOvl(false)
    table.cell(tb, 0, 3, "GAP · 2×FVG", bgcolor = hd, text_color = color.white, text_size = size.tiny)
    table.cell(tb, 1, 3, str.tostring(nB), bgcolor = hd, text_color = nB > 0 ? color.new(cOvlB, 0) : color.gray, text_size = size.tiny)
    table.cell(tb, 2, 3, str.tostring(nS), bgcolor = hd, text_color = nS > 0 ? color.new(cOvlS, 0) : color.gray, text_size = size.tiny)

    swTxt = na(lastSweepBar) ? "свипов не было" :
         (lastSweepHigh ? "BSL ↑ " : "SSL ↓ ") + str.tostring(bar_index - lastSweepBar) + " баров назад"
    table.cell(tb, 0, 4, "Свип", bgcolor = cl, text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 4, swTxt, bgcolor = cl, text_color = na(lastSweepBar) ? color.gray : color.new(cSweep, 0), text_size = size.tiny)
    table.cell(tb, 2, 4, "", bgcolor = cl)
    table.merge_cells(tb, 1, 4, 2, 4)

    smtTxt = not smtOn ? "укажите тикер в п.6" : (lastSweepSmt ? "есть на последнем свипе" : "нет на последнем свипе")
    table.cell(tb, 0, 5, "SMT", bgcolor = cl, text_color = color.silver, text_size = size.tiny)
    table.cell(tb, 1, 5, smtTxt, bgcolor = cl, text_color = not smtOn ? color.orange : (lastSweepSmt ? color.new(cSmt, 0) : color.gray), text_size = size.tiny)
    table.cell(tb, 2, 5, "", bgcolor = cl)
    table.merge_cells(tb, 1, 5, 2, 5)

    warn = tfSecHtf <= tfSecChart ? "⚠ ТФ анализа ≤ ТФ графика" : (useSession and not inSession ? "вне сессии" : syminfo.ticker + " · " + timeframe.period)
    table.cell(tb, 0, 6, warn, bgcolor = cl, text_color = tfSecHtf <= tfSecChart ? color.orange : color.silver, text_size = size.tiny)
    table.cell(tb, 1, 6, "", bgcolor = cl)
    table.cell(tb, 2, 6, "", bgcolor = cl)
    table.merge_cells(tb, 0, 6, 2, 6)
