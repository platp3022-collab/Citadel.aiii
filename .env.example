# Скопируй в .env и заполни своими значениями. .env не коммитится (см. .gitignore).

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Канал для алертов (бота нужно добавить туда админом с правом публикации)
TELEGRAM_CHANNEL_ID=

# Личный chat_id для команд и дублирования алертов (узнать через /id в чате с ботом)
TELEGRAM_CHAT_ID=

# Опционально, но желательно: без него автопилот по свежим лончам
# не сможет давать финальный вердикт нейросетью (скоринг и фильтры работают и без ключа)
ANTHROPIC_API_KEY=

# Профиль автопилота по свежим лончам: AXIOM | FOMO | SAFE | DEGEN
FRESH_PRESET=AXIOM

# Опционально: платный ключ Jupiter API (без него используется бесплатный lite-api)
JUPITER_API_KEY=

# ─── РЕАЛЬНАЯ ТОРГОВЛЯ ───────────────────────────────────────────────────────
# Приватный ключ кошелька, которым бот покупает и продаёт.
# Заводи ОТДЕЛЬНЫЙ кошелёк и держи там только то, что готов потерять.
# Формат: base58 (как экспортирует Phantom) или массив байтов [12,34,...].
# Пока строка пустая — бот работает на бумаге и денег не тратит.
SOLANA_PRIVATE_KEY=

# RPC-узел. Публичный режет по лимитам и часто отбивает транзакции —
# лучше бесплатный ключ Helius: https://dashboard.helius.dev
SOLANA_RPC_URL=

# Приватный узел только для отправки сделок. В открытом mempool транзакцию
# видят сэндвич-боты и успевают встать перед ней; приватный узел этого не даёт.
# Подойдёт защищённый endpoint Helius/QuickNode или Jito.
PRIVATE_RPC_URL=

# ─── МИНИ-АПП СО СТАТИСТИКОЙ ────────────────────────────────────────────────
# Ключ доступа к странице при открытии снаружи. Пусто — бот заведёт свой
# и положит в data/dashboard.key.
DASHBOARD_TOKEN=

# Если у тебя есть свой https-адрес (домен, свой туннель) — впиши его сюда,
# и cloudflared запускаться не будет.
DASHBOARD_PUBLIC_URL=
