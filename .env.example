# Скопируй в .env и заполни своими значениями. .env не коммитится (см. .gitignore).

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Канал для алертов (бота нужно добавить туда админом с правом публикации)
TELEGRAM_CHANNEL_ID=

# Личный chat_id для команд и дублирования алертов (узнать через /id в чате с ботом)
TELEGRAM_CHAT_ID=

# Опционально, для LLM-анализа монет
ANTHROPIC_API_KEY=

# ── Только для socialbot.py (соц-скам-сканер: TG/YouTube) ──────────────────

# my.telegram.org → API development tools → создать приложение.
# Нужен для юзер-клиента, который умеет читать чужие каналы (Bot API так не умеет).
# Лучше использовать отдельный (не основной) аккаунт.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# console.cloud.google.com → включить "YouTube Data API v3" → создать API key
YOUTUBE_API_KEY=
