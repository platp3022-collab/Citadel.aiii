# Скопируй в .env и заполни своими значениями. .env не коммитится (см. .gitignore).

# ── Сканер ──────────────────────────────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Канал для алертов (бота нужно добавить туда админом с правом публикации)
TELEGRAM_CHANNEL_ID=

# Личный chat_id для команд и дублирования алертов (узнать через /id в чате с ботом)
TELEGRAM_CHAT_ID=

# Опционально, для LLM-анализа монет
ANTHROPIC_API_KEY=

# ── Маркетинг-панель ────────────────────────────────────────────────────────
# Генерация контент-паков работает на том же ANTHROPIC_API_KEY (см. выше).
# Модель для маркетинга (по умолчанию claude-opus-5)
MARKETING_MODEL=

# Опционально: картинки по промтам из пака + расшифровка голосовых инфоповодов
OPENAI_API_KEY=

# Опционально: автопостинг в X (Twitter API v2, доступ Read and write).
# Ключи берутся в developer.x.com → Projects & Apps → Keys and tokens.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
