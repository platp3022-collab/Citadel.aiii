# Скопируй в .env и заполни своими значениями. .env не коммитится (см. .gitignore).

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Канал для алертов (бота нужно добавить туда админом с правом публикации)
TELEGRAM_CHANNEL_ID=

# Личный chat_id для команд и дублирования алертов (узнать через /id в чате с ботом)
TELEGRAM_CHAT_ID=

# Опционально, для LLM-анализа монет
ANTHROPIC_API_KEY=

# ── Citadel Trader (спот-бот со своей стратегией) ───────────────────────────
# Ключи биржи нужны ТОЛЬКО для реальной торговли (`python tradebot.py trade --live`).
# Для бумажной торговли и бэктестов их можно не заполнять.
# На бирже давай ключу права ТОЛЬКО на спот-торговлю, вывод средств — запретить.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Настройки бота (все необязательные, значения по умолчанию — в citadel/config.py)
CITADEL_EXCHANGE=binance
CITADEL_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
CITADEL_TIMEFRAME=1h
CITADEL_START_BALANCE=1000
CITADEL_MAX_POSITIONS=2
CITADEL_MAX_DRAWDOWN_STOP=0.25
CITADEL_RETRAIN_HOURS=24
